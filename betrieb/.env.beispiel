# Vorlage für .env neben compose.yaml. Alle Werte außer HAUSHALTSBUCH_PORT sind Pflicht.
# Passwörter und Secret zufällig wählen, z. B. mit: openssl rand -base64 32

# DEV zeigt in der Oberfläche einen Streifen „keine echten Daten eingeben“, PROD nicht.
HAUSHALTSBUCH_STAGE=PROD
# Port, unter dem die Anwendung im Netz erreichbar ist.
HAUSHALTSBUCH_PORT=8080

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# Gilt nur beim ersten Start von Keycloak (Realm-Import); später nur noch in Keycloak änderbar.
KEYCLOAK_CLIENT_SECRET=
