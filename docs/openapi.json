  "components" : {
    "schemas" : {
      "AnmeldungAnfrage" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "passwort" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "email", "passwort" ]
      },
      "AnstehendeKuendigung" : {
        "type" : "object",
        "properties" : {
          "anbieter" : {
            "type" : "string"
          },
          "betrag" : {
            "$ref" : "#/components/schemas/Betrag"
          },
          "bezeichnung" : {
            "type" : [ "string", "null" ]
          },
          "dringend" : {
            "type" : "boolean"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "kuendigenBis" : {
            "type" : "string",
            "format" : "date"
          },
          "zahlweise" : {
            "$ref" : "#/components/schemas/Zahlweise"
          },
          "zum" : {
            "type" : "string",
            "format" : "date"
          }
        },
        "required" : [ "anbieter", "betrag", "bezeichnung", "dringend", "id", "kuendigenBis", "zahlweise", "zum" ]
      },
      "Betrag" : {
        "type" : "object",
        "properties" : {
          "waehrung" : {
            "type" : "string"
          },
          "wert" : {
            "type" : "number"
          }
        },
        "required" : [ "waehrung", "wert" ]
      },
      "Feldfehler" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Name der Regel, z. B. NotBlank, Size, Unbekannt."
          },
          "feld" : {
            "type" : [ "string", "null" ],
            "description" : "Feld, z. B. passwort oder preis.wert; leer bei Regeln ohne Feld."
          },
          "parameter" : {
            "type" : "object",
            "additionalProperties" : true,
            "description" : "Gesetzte Attribute der Regel, z. B. {\"min\": 8}."
          }
        },
        "required" : [ "code", "parameter" ]
      },
      "Komponente" : {
        "type" : "string",
        "enum" : [ "FINANZUEBERSICHT", "VERTRAGSUEBERSICHT", "VERSORGUNGSVERTRAEGE", "PORTFOLIO" ]
      },
      "Kuendigung" : {
        "type" : "object",
        "properties" : {
          "art" : {
            "$ref" : "#/components/schemas/Kuendigungsart"
          },
          "dringend" : {
            "type" : "boolean"
          },
          "fristMonate" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          },
          "kuendigenBis" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          },
          "zum" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          }
        },
        "required" : [ "art", "dringend", "fristMonate", "kuendigenBis", "zum" ]
      },
      "Kuendigungsart" : {
        "type" : "string",
        "enum" : [ "KUENDIGEN_BIS", "MONATLICH_KUENDBAR", "ENDET", "KEINE_LAUFZEIT", "NICHT_KUENDBAR", "GEKUENDIGT", "BEENDET" ]
      },
      "Problem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Stabiler Fehlercode, z. B. VALIDIERUNG oder NICHT_ANGEMELDET; Tabelle in docs/api.md, Abschnitt Fehlerantworten."
          },
          "detail" : {
            "type" : "string",
            "description" : "Englisch, nur für Entwickler und Logs."
          },
          "felder" : {
            "type" : "array",
            "description" : "Nur bei VALIDIERUNG: je Verstoß ein Eintrag.",
            "items" : {
              "$ref" : "#/components/schemas/Feldfehler"
            }
          },
          "instance" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "status" ]
      },
      "Profil" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string"
